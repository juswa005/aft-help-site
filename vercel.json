{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/docker-compose.yml",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"docker-compose.yml\""
        },
        {
          "key": "Content-Type",
          "value": "application/x-yaml; charset=utf-8"
        }
      ]
    }
  ]
}
